{
  "buildCommand": "node scripts/import-official-trakt-config.mjs --if-missing && node scripts/import-official-mdblist-config.mjs --if-missing && npm run package:vidaa",
  "outputDirectory": "dist/vidaa",
  "regions": ["cdg1"],
  "functions": {
    "api/addon-data.js": {
      "maxDuration": 10
    },
    "api/diagnostic-report.js": {
      "maxDuration": 10
    },
    "api/media-tracks.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/d/:id",
      "destination": "/api/diagnostic-report?id=:id"
    }
  ],
  "headers": [
    {
      "source": "/:path*.:hash([a-f0-9]{16}).:ext(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/m/:file*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/vidaa.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/comparison/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/comparison/:build([a-f0-9]{16})/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "images": {
    "sizes": [128, 256, 640, 1280],
    "domains": [],
    "localPatterns": [],
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "raw.githubusercontent.com",
        "port": "",
        "pathname": "^/ImKaptain/nuvio-art/main/.*\\.(png|jpg|jpeg|webp)$",
        "search": ""
      },
      {
        "protocol": "https",
        "hostname": "cdn.xperience-app.com",
        "port": "",
        "pathname": "^/badges/(elite|nardbadges)/[a-zA-Z0-9_-]+\\.webp$",
        "search": ""
      },
      {
        "protocol": "https",
        "hostname": "images.metahub.space",
        "port": "",
        "pathname": "^/poster/(small|medium|large)/tt\\d+/img$",
        "search": ""
      }
    ],
    "qualities": [80],
    "minimumCacheTTL": 86400,
    "formats": ["image/webp"],
    "dangerouslyAllowSVG": false
  }
}
